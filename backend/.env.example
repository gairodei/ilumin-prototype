# Ilumin Academy backend: example configuration. PLACEHOLDERS ONLY.
# Copy to backend/.env for local development. Never commit a real .env (it is git-ignored).
# Every variable is validated at start-up; an invalid or missing value stops the process with a list of problems.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Runtime connection: the low-privilege API login role (member of ilumin_app). Never the owner or a superuser.
DATABASE_URL=postgres://ilumin_api:<app-password>@127.0.0.1:5432/ilumin_dev
# disable | require | verify-full (production refuses "disable")
DATABASE_SSL=disable
# Optional PEM file with the CA for verify-full
# DATABASE_SSL_CA_FILE=/path/to/ca.pem
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Migration connection: the schema-owner login role. Used only by `npm run migrate`, never by the API process.
MIGRATION_DATABASE_URL=postgres://ilumin_owner:<owner-password>@127.0.0.1:5432/ilumin_dev

# OpenID Connect identity provider (see backend/README.md, "Identity provider configuration").
# Exact issuer string as published in the provider's discovery document.
OIDC_ISSUER=https://<your-tenant>.example-idp.com/

# Authentication modes. Neither is on by default; at least one must be enabled.
#   Browser sign-in (authorization code + PKCE, backend-managed HttpOnly session cookie):
AUTH_SESSION_ENABLED=true
#   Bearer access tokens for non-browser clients (keep false unless a service client needs it):
AUTH_BEARER_ENABLED=false

# Browser sign-in (required when AUTH_SESSION_ENABLED=true). Register the backend at the provider as a CONFIDENTIAL
# client with exactly this redirect URI. The client secret comes from your secret store (required in production).
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<from-secret-store>
OIDC_REDIRECT_URI=https://<api-host>/v1/auth/callback
OIDC_SCOPES=openid email profile
# Where sign-in may send the browser afterwards: exact origins only, plus the default landing page.
AUTH_REDIRECT_ORIGINS=https://<app-host>
AUTH_DEFAULT_REDIRECT=https://<app-host>/
AUTH_LOGIN_TTL_SECONDS=600

# Session cookie and lifetime (operational defaults, not Academy policy). Production refuses SESSION_COOKIE_SECURE=false.
SESSION_COOKIE_SECURE=true
# lax | strict | none ("none" needs a cross-site frontend and Secure)
SESSION_COOKIE_SAMESITE=lax
# Leave empty: without a Domain the cookie is a __Host- cookie bound to the API host.
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_ROTATION_MINUTES=15
SESSION_ROTATION_GRACE_SECONDS=30
SESSION_RETENTION_DAYS=30

# Bearer mode only: comma-separated audience value(s) the provider puts in access tokens issued for this API.
OIDC_AUDIENCE=<api-audience-identifier>
# Asymmetric algorithms only (HS* and "none" are always refused).
OIDC_ALLOWED_ALGORITHMS=RS256,PS256,ES256
OIDC_CLOCK_TOLERANCE_SECONDS=30
# Optional: require this JOSE "typ" header (e.g. at+jwt for RFC 9068 access tokens).
# OIDC_REQUIRED_TOKEN_TYPE=at+jwt
# Link a provisioned user to a first-time identity by a provider-verified email (default off).
OIDC_LINK_BY_VERIFIED_EMAIL=false
# Only for local test issuers over http; refused when NODE_ENV=production.
OIDC_ALLOW_INSECURE_HTTP=false

# Rate limits as <requests>/<window seconds>. Login, callback failures and sensitive operations are counted in
# PostgreSQL (shared by all instances); the general API limit is per instance, in memory.
RATE_LIMIT_LOGIN=20/60
RATE_LIMIT_CALLBACK_FAILURES=10/900
RATE_LIMIT_SENSITIVE=30/60
RATE_LIMIT_API=600/60

# Background worker (npm run worker). Retention values are operational defaults, not record-retention policy.
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=120
OUTBOX_RETENTION_DAYS=30
JOB_RETENTION_DAYS=30
# none = notification messages wait in the outbox until a provider exists; capture = dev/test only (refused in production)
NOTIFICATION_TRANSPORT=none

# Comma-separated exact origins allowed to call the API from a browser (the frontend). Empty = no CORS. "*" is refused.
# With sessions enabled these origins (plus the API's own) are also the only Origins accepted on state-changing requests.
CORS_ALLOWED_ORIGINS=
# Reverse-proxy trust: false, a hop count (e.g. 1), or comma-separated proxy IPs/CIDRs. "true" is refused in production.
TRUST_PROXY=false

SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576
# Response-replay cache only; financial operations keep permanent records (see ADR 0011).
IDEMPOTENCY_RETENTION_HOURS=168
